# The Ledger: backend environment variables (Phase 0 specification, section 4.6)
#
# Every value below deliberately FAILS validation. Copying this file unchanged
# therefore stops the backend at start-up with a ConfigError naming each
# variable; it can never start a backend with known secrets. Replace each value
# with your own.
#
# On Replit, use Replit Secrets instead of a .env file. The loader ignores .env
# when REPL_ID or REPLIT_DEPLOYMENT is set.
#
# Never put any of these variables, or a VITE_-prefixed copy of them, in a
# client/.env* file: Vite exposes VITE_ variables to the browser bundle.
#
# Database URLs must state user, password, host and database explicitly.
# Nothing falls back to DATABASE_URL or the PG* variables.

# --- Optional settings (defaults shown; uncomment to change) ---
# NODE_ENV=development          # development | test | production
# PORT=5000                     # API only
# LOG_LEVEL=info                # fatal | error | warn | info | debug
# OUTBOX_MAX_ATTEMPTS=5         # worker only
# OUTBOX_BASE_BACKOFF_MS=1000   # worker only
# OUTBOX_POLL_INTERVAL_MS=1000  # worker only
# OUTBOX_BATCH_SIZE=10          # worker only
# OUTBOX_STALE_LOCK_MS=300000   # worker only

# --- API backend variables ---
# Outside production: set all four for full mode, or none for frontend-only mode.
# Setting only some of them is refused. In production all four are required.

# PostgreSQL URL for the ledger_app role.
LEDGER_APP_DATABASE_URL=postgresql://replace-me
# ES256 (P-256) private key, PKCS#8 PEM; \n escapes are accepted.
JWT_PRIVATE_KEY=replace-me
# ES256 (P-256) public key, SPKI PEM, matching JWT_PRIVATE_KEY.
JWT_PUBLIC_KEY=replace-me
# base64 or base64url text that decodes to at least 32 random bytes.
PORTAL_JWT_SECRET=replace-me

# --- Worker ---
# PostgreSQL URL for the ledger_worker role (required by the worker).
LEDGER_WORKER_DATABASE_URL=postgresql://replace-me

# --- Migrations (owner role; read only by npm run db:migrate and drizzle-kit) ---
LEDGER_MIGRATION_DATABASE_URL=postgresql://replace-me

# --- Tests (each database name must end in _test, and all three must name the same database) ---
LEDGER_APP_DATABASE_URL_TEST=postgresql://replace-me
LEDGER_WORKER_DATABASE_URL_TEST=postgresql://replace-me
LEDGER_MIGRATION_DATABASE_URL_TEST=postgresql://replace-me
